# ntfy.sh 手机推送频道(自选一个长随机名,手机 ntfy app 订阅同名频道)
NTFY_TOPIC=
# 数据目录,默认 ./data
DATA_DIR=
# `claude` CLI 的绝对路径,执行器(src/executor/runner.ts)用它 spawn headless 会话。
# 一般不用设:默认会依次尝试 ~/.local/bin/claude、PATH 里的 `claude`。只有在 launchd 常驻模式下
# (launchd 的 PATH 通常只有 /opt/homebrew/bin 之类,不包含 ~/.local/bin)且 claude 没装在
# ~/.local/bin 时才需要显式指定。
CLAUDE_BIN=
# ---- AI 提供方（设置页可切换；这里是数据库还没有保存选择时的默认值）----
# claude = 原有 Claude CLI；codex = 本机 Codex/ChatGPT 登录；gpt = OpenAI API key。
AI_PROVIDER=claude
# Codex CLI 的绝对路径（通常不用设，默认找 ~/.local/bin/codex、Windows npm 目录和 PATH）。
CODEX_BIN=
# Codex 模式可选模型覆盖；留空就用 Codex 当前配置的默认模型。
CODEX_FAST_MODEL=
CODEX_SMART_MODEL=
CODEX_AGENT_MODEL=
# GPT API 模式必填。OPENAI_MODEL 可统一指定；FAST/SMART/AGENT 可按任务档位覆盖。
# API key 只从服务器环境读取，设置页和日志都不会返回它。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_FAST_MODEL=
OPENAI_SMART_MODEL=
GPT_AGENT_MODEL=
# ---- 运维开关(平时都留空)----
# 关掉每分钟的扫描调度(本地调 UI 时用)。
SCAN_TICK_DISABLED=
# 关掉值守会话调度器(没有桌面会话心跳时不再自动拉起终端版 claude)。
ATTENDED_DISPATCH_DISABLED=
# 关掉 jd_review 补正文的自动接力:扫描后 / 上一个 run 结束后不再自动起 headless run,/apply 的「补正文」按钮仍可手动起。
# 2026-09-09 起 Mac 生产设为 1(迁移前不让 Mac 再后台开浏览器读岗位);切到 Windows 后那边不设即恢复。
JD_REVIEW_RELAY_DISABLED=
# ---- Windows 常开机(spec docs/superpowers/specs/2026-09-06-windows-server-migration-design.md)----
# 非 macOS 没有桌面通知,NTFY_TOPIC 是唯一通知通道:Windows 上务必配置(上面的 NTFY_TOPIC)。
# Chrome 可执行文件绝对路径(可选)。/apply「打开浏览器档案」用它拉起无头通道的 Chrome 档案;
# 不设则按平台探测(macOS 的 Chrome.app;Windows 的 Program Files / LocalAppData)。
CHROME_BIN=
# pdftotext(poppler)可执行文件路径(可选)。不设则用 PATH 里的 pdftotext;缺了只是跳过简历自检。
PDFTOTEXT_BIN=
# 仅 Windows:值守会话的拉起方式。默认 pty(node-pty 伪终端,有转录和自动回车);node-pty 装不上时设 console。
ATTENDED_SPAWN_MODE=
# 可选:分别覆盖调度器自动拉起的 Claude / Codex CLI 路径。
ATTENDED_CLAUDE_BIN=
ATTENDED_CODEX_BIN=
# 无人值守执行器(apply / network_* / jd_review)驱动的专属 Chrome 档案默认 headless(不弹窗口):常开机上
# jd_review 会自动接力,弹出来的浏览器窗口会打扰正在用电脑的人。设为 1 恢复有窗口模式(排查问题、或某站点拦 headless 时)。
# 设置页「打开后台浏览器,登录一次」按钮不受影响,仍然弹真实窗口。
EXECUTOR_BROWSER_HEADED=
# 自动备份(npm run backup / Windows 的 Sortie Backup 任务)保留天数,默认 14。
BACKUP_KEEP_DAYS=
# ---- 仅 Windows 阶段 2(自定义域名,Caddy;ops/windows/README.md §8)----
# 四个键都被 ops/windows/Caddyfile 直接引用(任务用 --envfile 加载),缺一个 Caddy 起不来。
# 自定义域名,如 sortie.example.com:Cloudflare 上加 A 记录指向 TS_IP,Proxy 关掉(灰云 DNS only)。
SORTIE_DOMAIN=
# 本机 tailnet 主机名(`tailscale status --json` 的 Self.DNSName 去掉末尾的点):Caddy 一并服务它,老网址不失效。
TS_HOSTNAME=
# 本机 Tailscale IPv4(`tailscale ip -4`):Caddy 只监听这块网卡。
TS_IP=
# Cloudflare API token:只给该 zone,权限必须同时有 Zone:Read 和 DNS:Edit(只给 DNS:Edit 会报 zone could not be found)。
CF_API_TOKEN=
# ---- 账号(spec docs/superpowers/specs/2026-09-13-accounts-design.md)----
# 浏览器访问 App 的完整地址(Google 登录回调、邮件里的链接都从这里拼)。不设则用 https://<SORTIE_DOMAIN>,
# 再不然 http://127.0.0.1:<PORT>。多个网址同时可用时,其余网址仍能登录(见 AUTH_TRUSTED_ORIGINS)。
BETTER_AUTH_URL=
# 会话签名密钥。不设则首次启动自动生成到 data/auth-secret(换机器/删 data 会让所有人重新登录)。
BETTER_AUTH_SECRET=
# 额外允许的来源(逗号分隔),默认已含 BETTER_AUTH_URL / SORTIE_DOMAIN / TS_HOSTNAME / 127.0.0.1 / localhost。
AUTH_TRUSTED_ORIGINS=
# Google 登录:Google Cloud Console → APIs & Services → Credentials → OAuth client (Web);授权回调填
#   <BETTER_AUTH_URL>/api/auth/callback/google(如 https://usesortie.com/api/auth/callback/google)。
# 两个都填了登录页才出现 Google 按钮。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 发邮件(验证邮箱、找回密码、改邮箱、删号确认)。配了才强制验证邮箱;不配则邮件写到 data/outbox/*.txt,
# 打开文件点链接即可。示例:smtps://user%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
# 只有这个邮箱注册的账号才能成为主账号(认领迁移前的数据、后台助手以它运行);不设则第一个注册的账号成为主账号。
SORTIE_OWNER_EMAIL=
# 设为 1 关闭注册(已有账号照常登录;Google 首次登录也会被拒)。
SIGNUP_DISABLED=
# 机器内部令牌:调度器、部署脚本、常开机上的桌面值守会话用它调 API(以主账号身份)。不设则首次启动生成到
# data/internal-token;会话读 `cat data/internal-token`。
SORTIE_INTERNAL_TOKEN=
